# Amigo Backend Configuration
# Copy this file to .env and fill in your values

# Application
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amigo

# Redis (for token blacklist + rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT — CHANGE THIS IN PRODUCTION!
JWT_SECRET_KEY=change_me_to_a_64_byte_random_string_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Security
RATE_LIMIT_PER_MINUTE=60

# External APIs (optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
